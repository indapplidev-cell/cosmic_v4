#:import dp kivy.metrics.dp
#:import GifBackground client.presentation.widgets.gif_background.GifBackground

<GameShellTitleWidget@MDRelativeLayout>:
    MDLabel:
        id: game_shell_title_text
        size_hint: 1, 1
        halign: "center"
        valign: "middle"
        text_size: self.size

    Image:
        id: game_shell_title_icon
        source: ""
        opacity: 0
        size_hint: 1, 1
        pos_hint: {"x": 0, "y": 0}
        fit_mode: "contain"
        mipmap: True

<GameScreenView>:
    MDRelativeLayout:
        id: root_layer
        MDRelativeLayout:
            id: gameplay_layout
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}
            GifBackground:
                id: game_bg_gif
                source: "client/assets/images/outerspace-55.gif"
                reverse: True
                size_hint: None, None
                size: self.parent.size
                pos: self.parent.pos
            MDRelativeLayout:
                id: game_surface_host
                size_hint: 1, 1
            AnchorLayout:
                id: gameplay_overlay
                anchor_x: "center"
                anchor_y: "top"
                padding: 0, dp(16), 0, 0
                MDLabel:
                    id: gameplay_timer_lbl
                    size_hint: None, None
                    size: dp(144), dp(40)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    opacity: 0
                    text: ""
        MDBoxLayout:
            id: main_layout
            orientation: "vertical"
            MDBoxLayout:
                id: topbar
                orientation: "horizontal"
                size_hint_y: None
                height: 0
                opacity: 0
                disabled: True
                MDBoxLayout:
                    id: lefttopbar
                MDBoxLayout:
                    id: midltopbar
                    AdsBannerSlot:
                        id: ads_banner_slot
                MDBoxLayout:
                    id: righttopbar
            MDBoxLayout:
                id: contentbar
                size_hint: 1, 1
                AnchorLayout:
                    id: content_center
                    anchor_x: "center"
                    anchor_y: "top"
                    MDBoxLayout:
                        id: game_frame
                        size_hint: 1, 1
                        MDRelativeLayout:
                            id: game_layer
                            size_hint: 1, 1
                            MDBoxLayout:
                                id: game_root
                                size_hint: 1, 1
                            MDLabel:
                                id: title_lbl
                                size_hint: 1, None
                                height: dp(96)
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                halign: "center"
                                valign: "middle"
                                text_size: self.width, self.height
            MDBoxLayout:
                id: bottombar
                AnchorLayout:
                    id: bottom_center
                    MDBoxLayout:
                        id: btn_stack
                        MDButton:
                            id: game_btn
                            MDButtonText:
                                id: game_btn_text
                        MDButton:
                            id: back_btn
                            MDButtonText:
                                id: back_btn_text
        MDRelativeLayout:
            id: touch_controls_layer
            opacity: 0
            disabled: True
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}
            # LEFT
            MDButton:
                id: btn_left
                style: "text"
                size_hint: None, None
                theme_bg_color: "Custom"
                md_bg_color: 0, 0, 0, 0
                theme_line_color: "Custom"
                line_color: 0, 0, 0, 0
                shadow_color: 0, 0, 0, 0
                ripple_alpha: 0
                on_press: root.on_screen_control("left", True)
                on_release: root.on_screen_control("left", False)
            Image:
                id: left_icon
                source: root.left_arrow_icon_source
                size_hint: None, None
                size: btn_left.size
                center: btn_left.center
                opacity: btn_left.opacity if self.source else 0
                fit_mode: "contain"
                mipmap: True
            Image:
                id: steering_icon
                source: root.steering_icon_source
                size_hint: None, None
                size: 0, 0
                opacity: 0
                fit_mode: "contain"
                mipmap: True
            MDButton:
                id: btn_brake_left
                style: "text"
                size_hint: None, None
                theme_bg_color: "Custom"
                md_bg_color: 0, 0, 0, 0
                theme_line_color: "Custom"
                line_color: 0, 0, 0, 0
                shadow_color: 0, 0, 0, 0
                ripple_alpha: 0
                on_press: root.on_screen_control("brake", True)
                on_release: root.on_screen_control("brake", False)
            Image:
                id: brake_icon_left
                source: root.brake_icon_source
                size_hint: None, None
                size: btn_brake_left.size
                center: btn_brake_left.center
                opacity: btn_brake_left.opacity if self.source else 0
                fit_mode: "contain"
                mipmap: True
            # RIGHT
            MDButton:
                id: btn_right
                style: "text"
                size_hint: None, None
                theme_bg_color: "Custom"
                md_bg_color: 0, 0, 0, 0
                theme_line_color: "Custom"
                line_color: 0, 0, 0, 0
                shadow_color: 0, 0, 0, 0
                ripple_alpha: 0
                on_press: root.on_screen_control("right", True)
                on_release: root.on_screen_control("right", False)
            Image:
                id: right_icon
                source: root.right_arrow_icon_source
                size_hint: None, None
                size: btn_right.size
                center: btn_right.center
                opacity: btn_right.opacity if self.source else 0
                fit_mode: "contain"
                mipmap: True
            MDButton:
                id: btn_brake_right
                style: "text"
                size_hint: None, None
                theme_bg_color: "Custom"
                md_bg_color: 0, 0, 0, 0
                theme_line_color: "Custom"
                line_color: 0, 0, 0, 0
                shadow_color: 0, 0, 0, 0
                ripple_alpha: 0
                on_press: root.on_screen_control("brake", True)
                on_release: root.on_screen_control("brake", False)
            Image:
                id: brake_icon_right
                source: root.brake_icon_source
                size_hint: None, None
                size: btn_brake_right.size
                center: btn_brake_right.center
                opacity: btn_brake_right.opacity if self.source else 0
                fit_mode: "contain"
                mipmap: True
