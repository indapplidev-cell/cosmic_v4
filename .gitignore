# Ignore everything by default
*
!builds/android/tools/make_diag_pack.ps1

# Allow directories so tracked folders can exist
!*/

# Allow source and data files
!*.py
!*.kv
!*.md
!*.json
!*.png
!*.jpg
!*.jpeg
!*.webp
!*.svg
!*.gif
!*.mp3
!*.wav
!*.ogg
!*.flac
!*.m4a
!*.sh
!*.yml

# Allow required root files
!.gitignore
!requirements.txt
!requirements_android.txt

# Keep required package folders
!uix/
!uix/__init__.py

# Explicit ignores
.venv/
.buildozer/
buildozer.spec
bin/
_buildozer_cfg/
android_build_env/
android_tools/
artifacts/
.venv_buildozer_local/
*.apk
*.aab
**/__pycache__/
__pycache__/
*.py[cod]
*.log
*.sha256*
*.bak*
*_REPORT*.md
*_REPO*.md
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.idea/
.vscode/
server/.env
logs/phone/
