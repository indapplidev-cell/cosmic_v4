<PasswordResetScreenView>:
    MDBoxLayout:
        id: main_layout
        orientation: "vertical"
        MDBoxLayout:
            id: topbar
            orientation: "horizontal"
            MDBoxLayout:
                id: lefttopbar
                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    MDLabel:
                        id: title_lbl
                        halign: "center"
                        valign: "middle"
                        text_size: self.size
            MDBoxLayout:
                id: midltopbar
            MDBoxLayout:
                id: righttopbar
        MDBoxLayout:
            id: contentbar
            AnchorLayout:
                id: content_center
                MDCard:
                    id: card
                    ScrollView:
                        id: content_scroll
                        do_scroll_x: False
                        do_scroll_y: True
                        bar_width: dp(4)
                        MDBoxLayout:
                            id: content_stack
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            MDTextField:
                                id: email_field
                                MDTextFieldHintText:
                                    id: email_hint
                                    text: ""
                            MDTextField:
                                id: code_field
                                input_filter: "int"
                                MDTextFieldHintText:
                                    id: code_hint
                                    text: ""
                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(8)
                                size_hint_x: 1
                                size_hint_y: None
                                height: new_password_field.height
                                MDTextField:
                                    id: new_password_field
                                    password: True
                                    password_mask: "*"
                                    size_hint_x: 1
                                    MDTextFieldHintText:
                                        id: new_password_hint
                                        text: ""
                                MDIconButton:
                                    id: new_password_eye_btn
                                    icon: "eye-off"
                                    pos_hint: {"center_y": 0.5}
                            MDLabel:
                                id: error_lbl
                            MDBoxLayout:
                                id: channel_row
                                orientation: "horizontal"
                                size_hint_y: None
                                height: dp(42)
                                spacing: dp(16)
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_x: 0.5
                                    spacing: dp(8)
                                    MDCheckbox:
                                        id: reset_channel_telegram
                                        group: "reset_channel"
                                    MDLabel:
                                        id: reset_channel_telegram_lbl
                                        text: "Telegram"
                                        halign: "left"
                                        valign: "middle"
                                        text_size: self.size
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_x: 0.5
                                    spacing: dp(8)
                                    MDCheckbox:
                                        id: reset_channel_email
                                        group: "reset_channel"
                                    MDLabel:
                                        id: reset_channel_email_lbl
                                        text: "Email"
                                        halign: "left"
                                        valign: "middle"
                                        text_size: self.size
        MDBoxLayout:
            id: bottombar
            AnchorLayout:
                id: bottom_center
                MDBoxLayout:
                    id: btn_stack
                    MDButton:
                        id: send_btn
                        MDButtonText:
                            id: send_btn_text
                    MDButton:
                        id: confirm_btn
                        MDButtonText:
                            id: confirm_btn_text
                    MDButton:
                        id: back_btn
                        MDButtonText:
                            id: back_btn_text
